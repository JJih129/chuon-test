%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed665b71816240adbace187e87522dc6, type: 3}
  m_Name: DialogueTable_KO
  m_EditorClassIdentifier: 
  entries:
  - key: tut.open.0
    speaker: EGO
    text: "\uAC00\uC0C1\uD604\uC2E4 \uBD80\uD305 \uC644\uB8CC.\n\uAC10\uAC01 \uB3D9\uAE30\uD654,
      \uC774\uC0C1 \uC5C6\uC74C."
    duration: 0
  - key: tut.open.1
    speaker: EGO
    text: "\uB0B4\uC77C \uC2F8\uC6B0\uB7EC \uAC00\uAE30 \uC804 \uB9C8\uC9C0\uB9C9
      \uD6C8\uB828\uC774\uC57C.\n\uAE34\uC7A5 \uD480\uC5B4, \uCD94\uC628."
    duration: 0
  - key: tut.open.2
    speaker: "\uCD94\uC628"
    text: "\uC7A1\uB2F4\uC740 \uB410\uC5B4. \uC2DC\uC791\uD574."
    duration: 0
  - key: tut.open.3
    speaker: EGO
    text: "\uB124\uB124, \uBC14\uB85C \uAC11\uB2C8\uB2E4. \uBB34\uC12D\uAE34."
    duration: 0
  - key: tut.movement.intro.0
    speaker: EGO
    text: "WASD\uB85C \uC55E\uCABD \uCCB4\uD06C \uC9C0\uC810\uAE4C\uC9C0 \uC774\uB3D9\uD574.\n\uAC00\uBCBC\uC6B4
      \uC0B0\uCC45\uC774\uC57C."
    duration: 0
  - key: tut.movement.success.0
    speaker: EGO
    text: "\uB2E4\uB9AC\uB294 \uBA40\uCA61\uD558\uB124. \uB2E4\uC74C."
    duration: 0
  - key: tut.camera.intro.0
    speaker: EGO
    text: "\uB9C8\uC6B0\uC2A4\uB85C \uC2DC\uC57C\uB97C \uB3CC\uB824\uC11C\n\uD45C\uC801\uC744
      \uD654\uBA74 \uC911\uC559\uC5D0 \uC7A1\uC544."
    duration: 0
  - key: tut.camera.remind.0
    speaker: EGO
    text: "\uD654\uBA74 \uD45C\uC2DC\uB97C \uB530\uB77C\uAC00.\n\uD45C\uC801\uC740
      \uC548 \uB3C4\uB9DD\uAC00. \uC544\uC9C1\uC740."
    duration: 0
  - key: tut.camera.success.0
    speaker: EGO
    text: "\uD45C\uC801 \uD3EC\uCC29. \uB208\uC370\uBBF8 \uC88B\uC740\uB370?"
    duration: 0
  - key: tut.lockon.intro.0
    speaker: EGO
    text: "\uB9C8\uC6B0\uC2A4 \uD720\uC744 \uB20C\uB7EC \uB77D\uC628\uD574.\n\uC2DC\uC120\uC774
      \uB188\uD55C\uD14C \uB531 \uBD99\uC744 \uAC70\uC57C."
    duration: 0
  - key: tut.lockon.remind.0
    speaker: EGO
    text: "\uD45C\uC801\uC744 \uBCF4\uACE0 \uD720 \uD074\uB9AD.\n\uB193\uCE58\uBA74
      \uB2E4\uC2DC \uB204\uB974\uBA74 \uB3FC."
    duration: 0
  - key: tut.lockon.success.0
    speaker: EGO
    text: "\uACE0\uC815 \uC644\uB8CC. \uC774\uC81C \uBCA8 \uC77C\uB9CC \uB0A8\uC558\uC5B4."
    duration: 0
  - key: tut.basic_attack.intro.0
    speaker: EGO
    text: "\uC88C\uD074\uB9AD \uC57D\uACF5, \uC6B0\uD074\uB9AD \uAC15\uACF5.\n\uAC01\uAC01
      10\uBC88\uC529 \uB9DE\uD600."
    duration: 0
  - key: tut.basic_attack.intro.1
    speaker: EGO
    text: "\uC57D\uACF5 4\uC5F0\uD0C0\uB97C \uB04A\uC9C0 \uB9D0\uACE0 \uC774\uC5B4
      \uBD10.\n\uADF8\uAC8C \uAE30\uBCF8 \uCF64\uBCF4\uC57C."
    duration: 0
  - key: tut.basic_attack.remind.0
    speaker: EGO
    text: "\uC88C\uD074\uB9AD, \uC6B0\uD074\uB9AD \uAC01\uAC01 10\uD68C.\n\uD5C8\uC218\uC544\uBE44\uB294
      \uC548 \uC544\uD30C\uD574."
    duration: 0
  - key: tut.basic_attack.success.0
    speaker: EGO
    text: "\uD0C0\uACA9 \uAC10\uAC01 \uD655\uC778. \uD5C8\uC218\uC544\uBE44\uD55C\uD14C\n\uC0B4\uC9DD
      \uBBF8\uC548\uD574\uC9C8 \uC815\uB3C4\uB124."
    duration: 0
  - key: tut.guard.intro.0
    speaker: EGO
    text: "\uBD89\uC740 \uACBD\uACE0\uC120\uC774 \uB728\uBA74 E\uB85C \uB9C9\uC544.\n\uC77C\uB2E8
      \uBC84\uD2F0\uB294 \uBC95\uBD80\uD130."
    duration: 0
  - key: tut.guard.remind.0
    speaker: EGO
    text: "\uBE68\uAC04 \uC120\uC774\uB791 \uB9C8\uCEE4 \uBCF4\uC774\uC9C0?\n\uBCF4\uC774\uBA74
      E. \uADF8\uAC8C \uC804\uBD80\uC57C."
    duration: 0
  - key: tut.guard.success.0
    speaker: EGO
    text: "\uC88B\uC544, \uBC29\uC5B4 \uB9AC\uB4EC \uC7A1\uD614\uC5B4."
    duration: 0
  - key: tut.parry.intro.0
    speaker: EGO
    text: "\uC774\uBC88\uC5D4 \uB9C9\uB294 \uAC8C \uC544\uB2C8\uB77C \uB04A\uB294
      \uAC70\uC57C.\n\uB9DE\uAE30 \uC9C1\uC804\uC5D0 E."
    duration: 0
  - key: tut.parry.intro.1
    speaker: EGO
    text: "\uD5EC\uBA67\uC774 \uBE5B\uB098\uB294 \uACF5\uACA9\uC740 \uD328\uB9C1
      \uAC00\uB2A5.\n\uADF8 \uBE5B\uC774 \uC2E0\uD638\uC57C."
    duration: 0
  - key: tut.parry.remind.0
    speaker: EGO
    text: "\uC11C\uB450\uB974\uC9C0 \uB9C8.\n\uACBD\uACE0\uAC00 \uACB9\uCE58\uB294
      \uC21C\uAC04\uC5D0 E."
    duration: 0
  - key: tut.parry.success.0
    speaker: EGO
    text: "\uAE54\uB054\uD574. \uADF8 \uAC10\uAC01 \uC78A\uC9C0 \uB9C8."
    duration: 0
  - key: tut.dodge.intro.0
    speaker: EGO
    text: "\uC774\uAC74 \uBC1B\uC9C0 \uB9C8. L-Shift\uB85C\n\uACF5\uACA9 \uBC94\uC704
      \uBC16\uC73C\uB85C \uBE60\uC838."
    duration: 0
  - key: tut.dodge.remind.0
    speaker: EGO
    text: "\uB9C9\uC9C0 \uB9D0\uACE0 \uD53C\uD574.\n\uB9C8\uCEE4 \uBC14\uAE65\uC73C\uB85C,
      L-Shift."
    duration: 0
  - key: tut.dodge.success.0
    speaker: EGO
    text: "\uC815\uB2F5. \uC548 \uB9DE\uB294 \uAC8C \uC81C\uC77C \uC2F8\uAC8C \uBA39\uD600."
    duration: 0
  - key: tut.perfect_dodge.intro.0
    speaker: EGO
    text: "\uD22C\uC0AC\uCCB4\uAC00 \uB2FF\uAE30 \uC9C1\uC804, \uD55C \uBC15\uC790
      \uB2A6\uAC8C\nL-Shift. \uADF8\uAC8C \uD37C\uD399\uD2B8 \uD68C\uD53C\uC57C."
    duration: 0
  - key: tut.perfect_dodge.intro.1
    speaker: EGO
    text: "\uC131\uACF5\uD558\uBA74 \uC2DC\uAC04\uC774 \uB290\uB824\uC9C0\uACE0\n\uAC8C\uC774\uC9C0\uAC00
      \uCC28. \uAF64 \uC9DC\uB9BF\uD558\uC9C0."
    duration: 0
  - key: tut.perfect_dodge.remind.0
    speaker: EGO
    text: "\uB108\uBB34 \uBE68\uB77C. \uD55C \uBC15\uC790 \uB2A6\uAC8C.\n\uB2FF\uAE30
      \uC9C1\uC804\uC5D0 \uD53C\uD574."
    duration: 0
  - key: tut.perfect_dodge.success.0
    speaker: EGO
    text: "\uADF8\uAC70\uC57C. \uBC29\uAE08 \uC138\uC0C1\uC774\n\uBA48\uCD98 \uAC83
      \uAC19\uC558\uC9C0?"
    duration: 0
  - key: tut.heal.intro.0
    speaker: EGO
    text: "\uCCB4\uB825\uC774 \uAE4E\uC600\uC5B4. Q\uB85C \uC570\uD50C \uD22C\uC5EC.\n\uC228
      \uB3CC\uB9B4 \uD2C8\uC5D0 \uC4F0\uB294 \uAC70\uC57C."
    duration: 0
  - key: tut.heal.success.0
    speaker: EGO
    text: "\uD68C\uBCF5 \uC644\uB8CC. \uC570\uD50C\uC740 \uAC04\uC2DD \uC544\uB2C8\uC57C,\n\uCD94\uC628.
      \uC544\uAEF4 \uBA39\uC5B4."
    duration: 0
  - key: tut.ultimate.intro.0
    speaker: EGO
    text: "\uD398\uC774\uC988 \uAC8C\uC774\uC9C0\uAC00 \uAF49 \uCC3C\uC5B4.\nR\uB85C
      \uAD81\uADF9\uAE30. \uD310\uC744 \uB4A4\uC9D1\uC790."
    duration: 0
  - key: tut.ultimate.success.0
    speaker: EGO
    text: "\uBD24\uC9C0? \uC6B0\uB9AC \uB458\uC774 \uC81C\uB300\uB85C\n\uB9DE\uBB3C\uB9AC\uBA74
      \uC774 \uC815\uB3C4\uC57C."
    duration: 0
  - key: tut.exit.intro.0
    speaker: EGO
    text: "\uD6C8\uB828 \uC885\uB8CC. \uCD9C\uAD6C\uB85C \uAC00.\n\uC774\uC81C \uD604\uC2E4\uB85C
      \uB3CC\uC544\uAC04\uB2E4."
    duration: 0
  - key: tut.exit.success.0
    speaker: "\uCD94\uC628"
    text: "\uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uC9C4\uC9DC\uB85C \uAC04\uB2E4."
    duration: 0
  - key: tutm.move.0
    speaker: EGO
    text: "WASD\uB85C \uC9C0\uC815 \uC704\uCE58\uAE4C\uC9C0 \uC774\uB3D9\uD574.\n\uAC00\uBCBC\uC6B4
      \uC0B0\uCC45\uC774\uC57C."
    duration: 0
  - key: tutm.move.1
    speaker: EGO
    text: "\uC2DC\uC57C\uB294 \uB9C8\uC6B0\uC2A4, \uD68C\uD53C\uB294 L-Shift.\n\uB2E4\uC12F
      \uBC88 \uAD74\uB7EC \uBD10."
    duration: 0
  - key: tutm.attack.0
    speaker: EGO
    text: "\uC774\uC81C \uCE7C \uC880 \uC368 \uBCF4\uC790."
    duration: 0
  - key: tutm.attack.1
    speaker: EGO
    text: "\uC88C\uD074\uB9AD \uC57D\uACF5, \uC6B0\uD074\uB9AD \uAC15\uACF5.\n\uC57D\uACF5
      4\uC5F0\uD0C0\uAC00 \uAE30\uBCF8 \uCF64\uBCF4\uC57C."
    duration: 0
  - key: tutm.mid.0
    speaker: "\uCD94\uC628"
    text: "\uBAB8 \uD480\uB838\uC5B4. \uB2E4\uC74C."
    duration: 0
  - key: tutm.defense.0
    speaker: EGO
    text: "\uC774\uBC88\uC5D4 \uBC29\uC5B4\uC640 \uD328\uB9C1.\n\uB9DE\uC73C\uBA74\uC11C
      \uBC30\uC6B0\uB294 \uC2DC\uAC04\uC774\uC57C."
    duration: 0
  - key: tutm.defense.1
    speaker: EGO
    text: "E\uB85C \uBC29\uC5B4, \uB9DE\uAE30 \uC9C1\uC804\uC5D0 E\uBA74 \uD328\uB9C1.\n\uD5EC\uBA67\uC774
      \uBE5B\uB098\uBA74 \uADF8\uAC8C \uC2E0\uD638\uC57C."
    duration: 0
  - key: tutm.heal.0
    speaker: "\uCD94\uC628"
    text: "\uB2E4\uCE58\uBA74 \uBC14\uB85C \uD68C\uBCF5. \uAE30\uBCF8\uC774\uC9C0."
    duration: 0
  - key: tutm.heal.1
    speaker: EGO
    text: "Q\uB85C \uC570\uD50C \uD22C\uC5EC.\n\uC228 \uB3CC\uB9B4 \uD2C8\uC5D0 \uC368."
    duration: 0
  - key: tutm.complete.0
    speaker: EGO
    text: "\uAE30\uBCF8 \uD6C8\uB828 \uB05D. \uD569\uACA9\uC774\uC57C, \uCD94\uC628.\n\u2026\uC6D0\uB798
      \uD569\uACA9 \uAC19\uC740 \uAC74 \uC5C6\uC9C0\uB9CC."
    duration: 0
  - key: lobby.fromtut.0
    speaker: EGO
    text: "\uC2DC\uBBAC\uB808\uC774\uC158\uC740 \uB05D\uB0AC\uC5B4, \uCD94\uC628.\n\uC5EC\uAE30\uC11C\uBD80\uD134
      \uC9C4\uC9DC\uC57C."
    duration: 0
  - key: lobby.fromtut.1
    speaker: "\uCD94\uC628"
    text: "\uC54C\uC544. \uB4E4\uC5B4\uAC04\uB2E4."
    duration: 0
  - key: lobby.arrive.0
    speaker: "\uCD94\uC628"
    text: "\uC5EC\uAE30\uAC00 \uB188\uB4E4\uC758 \uC2EC\uC7A5\uBD80\u2026"
    duration: 0
  - key: lobby.arrive.1
    speaker: EGO
    text: "\uC2EC\uC7A5\uCE58\uACE4 \uAF64 \uBC18\uC9DD\uAC70\uB9AC\uB124.\n\uD53C
      \uB0C4\uC0C8\uB294 \uC798\uB3C4 \uC9C0\uC6E0\uC5B4."
    duration: 0
  - key: lobby.alarm.0
    speaker: System
    text: "\uCE68\uC785\uC790 \uAC10\uC9C0.\n\uBC29\uC5B4 \uD504\uB85C\uD1A0\uCF5C\uC744
      \uAC00\uB3D9\uD569\uB2C8\uB2E4."
    duration: 0
  - key: lobby.alarm.1
    speaker: System
    text: "\uC784\uC9C1\uC6D0 \uC5EC\uB7EC\uBD84\uC740\n\uC5C5\uBB34\uB97C \uACC4\uC18D\uD574
      \uC8FC\uC2ED\uC2DC\uC624."
    duration: 0
  - key: lobby.drones.0
    speaker: EGO
    text: "\uD504\uB860\uD2B8 \uB370\uC2A4\uD06C \uB4A4\uC5D0\uC11C \uB4DC\uB860\uC774
      \uB098\uC640.\n\uC190\uB2D8 \uC811\uB300 \uD55C\uBC88 \uAC70\uCE60\uB2E4."
    duration: 0
  - key: lobby.drones.1
    speaker: "\uCD94\uC628"
    text: "\uC804\uBD80 \uBD80\uC21C\uB2E4."
    duration: 0
  - key: lobby.post.0
    speaker: EGO
    text: "\uC815\uB9AC \uB05D. \uC77C\uBC18 \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294\n\uC804\uBD80
      \uC7A0\uACA8 \uC788\uC5B4."
    duration: 0
  - key: lobby.post.1
    speaker: "\uCD94\uC628"
    text: "\uB2E4\uB978 \uAE38\uC740?"
    duration: 0
  - key: lobby.post.2
    speaker: EGO
    text: "\uD504\uB860\uD2B8 \uB370\uC2A4\uD06C \uB4A4\uD3B8 \uC5D8\uB9AC\uBCA0\uC774\uD130
      \uD558\uB098\uB9CC\n\uC0B4\uC544 \uC788\uC5B4. \uC800\uCABD\uC774\uC57C."
    duration: 0
  - key: lobby.elev.0
    speaker: EGO
    text: "\uC774 \uC5D8\uB9AC\uBCA0\uC774\uD130, \uACA9\uB0A9\uACE0 \uCE35\uC73C\uB85C\uB9CC
      \uAC00.\n\uBC84\uD2BC\uC774 \uB531 \uD558\uB098\uC57C."
    duration: 0
  - key: lobby.elev.1
    speaker: "\uCD94\uC628"
    text: "\uB188\uB4E4\uC774 \uC77C\uBD80\uB7EC \uC5F4\uC5B4\uB454 \uAE38\uC778\uAC00."
    duration: 0
  - key: lobby.elev.2
    speaker: EGO
    text: "\uD568\uC815 \uB0C4\uC0C8\uAC00 \uB098. \uADF8\uB798\uB3C4 \uAE38\uC740
      \uC774\uAC83\uBFD0.\n\uD0C0, \uCD94\uC628."
    duration: 0
  - key: lobby.elev.3
    speaker: "\uCD94\uC628"
    text: "\u2026\uB05D\uB098\uBA74 \uBC25\uBD80\uD130 \uBA39\uC744 \uAC70\uC57C."
    duration: 0
  - key: lobby.elev.4
    speaker: EGO
    text: "\uC88B\uC740 \uB3D9\uAE30\uC57C. \uC0B4\uC544 \uB098\uAC00\uBA74 \uACF1\uBE7C\uAE30."
    duration: 0
  - key: lobby.sync.0
    speaker: EGO
    text: "\uACBD\uB85C \uACE0\uC815. \uACA9\uB0A9\uACE0 \uCE35\uC73C\uB85C \uB0B4\uB824\uAC04\uB2E4."
    duration: 0
  - key: boss.intro.0
    speaker: EGO
    text: "\uB3C4\uCC29. \uACA9\uB0A9\uACE0 \uCE35\uC774\uC57C, \uCD94\uC628."
    duration: 0
  - key: boss.intro.1
    speaker: "\uCD94\uC628"
    text: "\uC77C\uBD80\uB7EC \uC5EC\uAE30\uB85C \uBCF4\uB0B8 \uAC70\uAD70."
    duration: 0
  - key: boss.intro.2
    speaker: EGO
    text: "\uBCF4\uC548\uB9DD\uC774 \uC870\uC6A9\uD574. \uB108\uBB34 \uC870\uC6A9\uD574.\n\uC774\uB7F0
      \uAC74 \uBCF4\uD1B5 \uBCF5\uC120\uC774\uAC70\uB4E0."
    duration: 0
  - key: boss.intro.3
    speaker: EGO
    text: "\uC815\uC815\uD560\uAC8C. \uBC29\uAE08\uBD80\uB85C \uC2DC\uB044\uB7EC\uC6CC\uC84C\uC5B4."
    duration: 0
  - key: boss.intro.4
    speaker: EGO
    text: "\uC804\uBC29 \uACE0\uC5D0\uB108\uC9C0 \uBC18\uC751. \uC778\uAC04\uD615\u2026\n\uC544\uB2C8,
      \uC2E4\uD5D8\uCCB4\uC57C."
    duration: 0
  - key: boss.intro.5
    speaker: "\uCD94\uC628"
    text: "\u2026\uB098\uB791 \uAC19\uC740 \uBD80\uB958\uAD70."
    duration: 0
  - key: boss.intro.6
    speaker: EGO
    text: "Type-D. \uB108\uC640 \uAC19\uC740 \uC2E4\uD5D8\uCCB4 \uC2DC\uB9AC\uC988\uC57C.\n\uC774
      \uACA9\uB0A9\uACE0\uC758 \uBB38\uC9C0\uAE30\uC9C0."
    duration: 0
  - key: boss.intro.7
    speaker: "\uCD94\uC628"
    text: "\uADF8\uB7FC \uBCA0\uBA74 \uB418\uACA0\uB124."
    duration: 0
  - key: boss.intro.8
    speaker: EGO
    text: "\uBA3C\uC800 \uC77D\uACE0 \uB4E4\uC5B4\uAC00. \uD798\uC73C\uB85C \uBC00\uBA74\n\uB124\uAC00
      \uBA3C\uC800 \uBD80\uC11C\uC838, \uCD94\uC628."
    duration: 0
  - key: boss.intro.9
    speaker: "\uCD94\uC628"
    text: "\uAC71\uC815 \uB9C8. \uB05D\uAE4C\uC9C0 \uBCA8 \uAC70\uC57C."
    duration: 0
  - key: boss.intro.typed
    speaker: Type-D
    text: "\uC2E4\uD5D8\uCCB4 07\uD638 \uD655\uC778.\n\uD3D0\uAE30 \uC808\uCC28\uB97C
      \uC7AC\uAC1C\uD55C\uB2E4."
    duration: 0
  - key: ending.tsukasa
    speaker: "\uCE20\uCE74\uC0AC"
    text: "\uACB0\uAD6D \uC77C\uC5B4\uB098 \uBC84\uB838\uB098.. \uD558\uC9C0\uB9CC
      \uB10C \uC544\uC9C1 \uB0B4\uAC00 \uC124\uACC4\uD55C \uADA4\uB3C4 \uC704\uB97C
      \uAC77\uACE0 \uC788\uC744 \uBFD0\uC774\uB2E4."
    duration: 0
  - key: ending.reply.0
    speaker: "\uCD94\uC628"
    text: "\uADF8 \uADA4\uB3C4, \uB0B4\uAC00 \uB04A\uC5B4 \uC8FC\uC9C0."
    duration: 2
  - key: ending.reply.1
    speaker: EGO
    text: "\uC124\uACC4\uC790 \uC591\uBC18, \uB0A0 \uBC84\uB9B0 \uAC70 \uD6C4\uD68C\uD560\uAC78.\n\uB09C
      \uC608\uCE21 \uBD88\uAC00\uB2A5\uD558\uAC70\uB4E0."
    duration: 2.6
  - key: tut.inf.move.intro.0
    speaker: EGO
    text: "\uB808\uC9C0\uC2A4\uD0D5\uC2A4\uAC00 \uC9E0 \uB0B4\uC77C \uCE68\uD22C
      \uACBD\uB85C\uC57C.\n\uAC70\uB9AC\uC5D0\uC11C \uBCF8\uC0AC \uB85C\uBE44 \uBB38
      \uC55E\uAE4C\uC9C0."
    duration: 0
  - key: tut.inf.move.intro.1
    speaker: EGO
    text: "{move}\uB85C \uAC00\uB85C\uB4F1 \uC544\uB798 \uD45C\uC2DD\uAE4C\uC9C0.\n\uB0B4\uC77C\uC740
      \uC774 \uAE38\uC744 \uC9C4\uC9DC\uB85C \uAC77\uB294 \uAC70\uC57C."
    duration: 0
  - key: tut.inf.move.success.0
    speaker: EGO
    text: "\uB2E4\uB9AC\uB294 \uBA40\uCA61\uD558\uB124. \uB2E4\uC74C."
    duration: 0
  - key: tut.inf.look.intro.0
    speaker: EGO
    text: "{look}\uB85C \uC2DC\uC57C\uB97C \uB3CC\uB824 \uBD10.\n\uAC70\uB9AC \uB05D,
      \uBD89\uC740 \uC5E0\uBE14\uB7FC."
    duration: 0
  - key: tut.inf.look.remind.0
    speaker: EGO
    text: "\uACE0\uAC1C \uB4E4\uC5B4, \uCD94\uC628.\n\uAC70\uB9AC \uB05D\uC5D0\uC11C
      \uC81C\uC77C \uD070 \uBE4C\uB529."
    duration: 0
  - key: tut.inf.look.success.0
    speaker: "\uCD94\uC628"
    text: "\uCE20\uCE74\uC0AC \uBCF8\uC0AC\u2026"
    duration: 0
  - key: tut.inf.look.success.1
    speaker: EGO
    text: "\uB0B4\uC77C\uC758 \uBAA9\uC801\uC9C0. \uC624\uB298\uC740\n\uB85C\uBE44
      \uBB38 \uC55E\uAE4C\uC9C0\uB9CC \uAC00 \uBCF4\uC790."
    duration: 0
  - key: tut.inf.dodge.intro.0
    speaker: EGO
    text: "{dodge}\uB85C \uD68C\uD53C. \uB450 \uBC88 \uAD74\uB7EC \uBD10.\n\uAD6C\uB974\uB294
      \uC21C\uAC04\uC5D4 \uC544\uBB34\uAC83\uB3C4 \uC548 \uB2FF\uC544."
    duration: 0
  - key: tut.inf.dodge.success.0
    speaker: EGO
    text: "\uC88B\uC544. \uADF8 \uBB34\uC801 \uD504\uB808\uC784\uC774\n\uC624\uB298\uC758
      \uCCAB \uBC88\uC9F8 \uC5F4\uC1E0\uC57C."
    duration: 0
  - key: tut.inf.scan.intro.0
    speaker: EGO
    text: "\uC55E\uC5D0 \uBCF4\uC548 \uC2A4\uCE90\uB108 \uBE54. \uAC78\uC5B4\uAC00\uBA74
      \uAC78\uB824.\n\uBE54 \uBC14\uB85C \uC55E\uC5D0\uC11C \uAD74\uB7EC\uC11C \uD1B5\uACFC\uD574."
    duration: 0
  - key: tut.inf.scan.remind.0
    speaker: EGO
    text: "\uAC78\uC5B4\uAC00\uBA74 \uAC10\uC9C0\uB3FC.\n\uBE54 \uBC14\uB85C \uC55E\uC5D0\uC11C
      {dodge}."
    duration: 0
  - key: tut.inf.scan.success.0
    speaker: EGO
    text: "\uC2A4\uCE90\uB108 \uD1B5\uACFC. \uAE30\uB85D\uC5D4\n\uACE0\uC591\uC774
      \uD55C \uB9C8\uB9AC \uC815\uB3C4\uB85C \uB0A8\uC558\uC744\uAC78."
    duration: 0
  - key: tut.inf.lockon.intro.0
    speaker: EGO
    text: "\uAC80\uBB38\uC18C \uACBD\uBE44 \uC548\uB4DC\uB85C\uC774\uB4DC. \uB4F1
      \uB3CC\uB838\uC9C0?\n{lockon}\uC73C\uB85C \uB77D\uC628\uD574."
    duration: 0
  - key: tut.inf.lockon.remind.0
    speaker: EGO
    text: "\uB188\uC744 \uD654\uBA74\uC5D0 \uB450\uACE0 {lockon}.\n\uC2DC\uC120\uC774
      \uB531 \uBD99\uC744 \uAC70\uC57C."
    duration: 0
  - key: tut.inf.lockon.success.0
    speaker: EGO
    text: "\uACE0\uC815 \uC644\uB8CC. \uC774\uC81C \uBCA8 \uC77C\uB9CC \uB0A8\uC558\uC5B4."
    duration: 0
  - key: tut.inf.combo.intro.0
    speaker: EGO
    text: "{light} \uC57D\uACF5, {heavy} \uAC15\uACF5.\n\uC57D\uACF5 \uC138 \uBC88,
      \uAC15\uACF5 \uD55C \uBC88 \uB123\uACE0 \uC815\uB9AC\uD574."
    duration: 0
  - key: tut.inf.combo.remind.0
    speaker: EGO
    text: "\uC57D\uACF5\uC740 {light}, \uAC15\uACF5\uC740 {heavy}.\n\uB04A\uC9C0
      \uB9D0\uACE0 \uC774\uC5B4."
    duration: 0
  - key: tut.inf.combo.success.0
    speaker: EGO
    text: "\uAE54\uB054\uD574. \uC2DC\uBBAC\uB808\uC774\uC158 \uACBD\uBE44\uB77C\uB3C4\n\uC0B4\uC9DD
      \uBBF8\uC548\uD574\uC9C8 \uC815\uB3C4\uB124."
    duration: 0
  - key: tut.inf.guard.intro.0
    speaker: EGO
    text: "\uBD80\uC2A4\uC5D0\uC11C \uD558\uB098 \uB354 \uB098\uC628\uB2E4.\n{guard}\uB97C
      \uB204\uB974\uACE0 \uC788\uC73C\uBA74 \uB9C9\uC544."
    duration: 0
  - key: tut.inf.guard.remind.0
    speaker: EGO
    text: "\uB188\uC774 \uD718\uB450\uB97C \uB54C E.\n\uC77C\uB2E8 \uBC84\uD2F0\uB294
      \uBC95\uBD80\uD130."
    duration: 0
  - key: tut.inf.guard.success.0
    speaker: EGO
    text: "\uC88B\uC544, \uBC29\uC5B4 \uB9AC\uB4EC \uC7A1\uD614\uC5B4."
    duration: 0
  - key: tut.inf.parry.intro.0
    speaker: EGO
    text: "\uC138 \uBC88\uC9F8 \uACF5\uACA9 \uC804\uC5D0 \uD5EC\uBA67\uC774 \uAE08\uC0C9\uC73C\uB85C\n\uBC88\uCA4D\uC5EC.
      \uADF8\uAC8C \uD328\uB9C1 \uC2E0\uD638\uC57C."
    duration: 0
  - key: tut.inf.parry.intro.1
    speaker: EGO
    text: "\uB9DE\uAE30 \uC9C1\uC804\uC5D0 {guard}.\n\uB9C9\uB294 \uAC8C \uC544\uB2C8\uB77C
      \uB04A\uB294 \uAC70\uC57C."
    duration: 0
  - key: tut.inf.parry.remind.0
    speaker: EGO
    text: "\uAE08\uC0C9 \uC12C\uAD11\uC774 \uBCF4\uC774\uBA74\n\uD55C \uBC15\uC790
      \uAE30\uB2E4\uB838\uB2E4\uAC00 {guard}."
    duration: 0
  - key: tut.inf.parry.success.0
    speaker: EGO
    text: "\uADF8\uAC70\uC57C! \uD295\uACA8\uB0B8 \uC21C\uAC04\uC774\n\uC81C\uC77C
      \uD06C\uAC8C \uBCA8 \uAE30\uD68C\uC57C."
    duration: 0
  - key: tut.inf.clear.intro.0
    speaker: EGO
    text: "\uB0A8\uC740 \uACBD\uBE44 \uC815\uB9AC\uD558\uBA74\n\uCC28\uB2E8\uAE30\uAC00
      \uC5F4\uB824."
    duration: 0
  - key: tut.inf.clear.success.0
    speaker: EGO
    text: "\uAC80\uBB38\uC18C \uD1B5\uACFC. \uB0B4\uC77C \uC9C4\uC9DC \uACBD\uBE44\uB294\n\uC774\uB807\uAC8C
      \uC21C\uC21C\uD788 \uC548 \uC5F4\uC5B4 \uC904 \uAC70\uC57C."
    duration: 0
  - key: tut.inf.to_dock.intro.0
    speaker: EGO
    text: "\uC815\uBB38\uC740 \uBD09\uC1C4\uC57C.\n\uC11C\uBE44\uC2A4 \uACE8\uBAA9
      \uC9C0\uB098 \uD558\uC5ED\uC7A5\uC73C\uB85C."
    duration: 0
  - key: tut.inf.to_dock.success.0
    speaker: "\uCD94\uC628"
    text: "\uD558\uC5ED\uC7A5\uC774\uAD70."
    duration: 0
  - key: tut.inf.red.intro.0
    speaker: EGO
    text: "\uD558\uC5ED\uC7A5 \uBCBD\uC5D0 \uD130\uB81B. \uBE68\uAC04 \uBE5B\uC740\n\uB9C9\uC744
      \uC218\uB3C4, \uD328\uB9C1\uD560 \uC218\uB3C4 \uC5C6\uC5B4."
    duration: 0
  - key: tut.inf.red.intro.1
    speaker: EGO
    text: "\uC870\uC900\uC120\uC774 \uACE0\uC815\uB418\uBA74 \uC606\uC73C\uB85C \uBE44\uCF1C.\n\uCEE8\uD14C\uC774\uB108\uB97C
      \uC5C4\uD3D0\uBB3C\uB85C \uC368."
    duration: 0
  - key: tut.inf.red.remind.0
    speaker: EGO
    text: "\uBE68\uAC15\uC740 \uBC1B\uC9C0 \uB9C8.\n\uC870\uC900\uC120 \uBC16\uC73C\uB85C
      \uD55C \uAC78\uC74C."
    duration: 0
  - key: tut.inf.red.success.0
    speaker: EGO
    text: "\uD130\uB81B \uC7A0\uAE50 \uBA48\uCDC4\uC5B4.\n\uBE68\uAC15 = \uD53C\uD55C\uB2E4.
      \uC78A\uC9C0 \uB9C8."
    duration: 0
  - key: tut.inf.heal.intro.0
    speaker: EGO
    text: "\uAE01\uD614\uB124. {heal}\uB85C \uC570\uD50C \uD22C\uC5EC.\n\uC228 \uB3CC\uB9B4
      \uD2C8\uC5D0 \uC4F0\uB294 \uAC70\uC57C."
    duration: 0
  - key: tut.inf.heal.success.0
    speaker: EGO
    text: "\uD68C\uBCF5 \uC644\uB8CC. \uC570\uD50C\uC740 \uAC04\uC2DD \uC544\uB2C8\uC57C,\n\uCD94\uC628.
      \uC544\uAEF4 \uBA39\uC5B4."
    duration: 0
  - key: tut.inf.pd.intro.0
    speaker: EGO
    text: "\uD50C\uB7AB\uD3FC\uC740 \uC881\uC544\uC11C \uBE44\uD0AC \uB370\uAC00
      \uC5C6\uC5B4.\n\uC774\uBC88\uC5D4 \uBE68\uAC15\uC744 \uC815\uBA74\uC73C\uB85C
      \uB118\uB294\uB2E4."
    duration: 0
  - key: tut.inf.pd.intro.1
    speaker: EGO
    text: "\uD0C4\uC774 \uB2FF\uAE30 \uC9C1\uC804, \uD55C \uBC15\uC790 \uB2A6\uAC8C\n{dodge}.
      \uADF8\uAC8C \uD37C\uD399\uD2B8 \uD68C\uD53C\uC57C."
    duration: 0
  - key: tut.inf.pd.remind.0
    speaker: EGO
    text: "\uB108\uBB34 \uBE68\uB77C. \uC870\uC900\uC120\uC774 \uBA48\uCD94\uACE0\n\uD55C
      \uBC15\uC790 \uB4A4\uC5D0 \uAD74\uB7EC."
    duration: 0
  - key: tut.inf.pd.assist.0
    speaker: EGO
    text: "\uD310\uC815 \uBCF4\uC870 \uCF30\uC5B4. \uC2DC\uBBAC\uB808\uC774\uC158\uC774\uB2C8\uAE4C\n\uC774\uBC88\uB9CC
      \uBD10\uC900\uB2E4."
    duration: 0
  - key: tut.inf.pd.success.0
    speaker: EGO
    text: "\uADF8\uAC70\uC57C. \uBC29\uAE08 \uC138\uC0C1\uC774\n\uBA48\uCD98 \uAC83
      \uAC19\uC558\uC9C0?"
    duration: 0
  - key: tut.inf.to_side.intro.0
    speaker: EGO
    text: "\uC154\uD130 \uD1B5\uB85C \uB108\uBA38\uAC00 \uCE21\uBA74 \uCD9C\uC785\uAD6C.\n\uB85C\uBE44
      \uBC14\uB85C \uC55E\uC774\uC57C."
    duration: 0
  - key: tut.inf.enforcer.intro.0
    speaker: EGO
    text: "\uBC29\uD328 \uC9D1\uD589\uAD00. \uC815\uBA74 \uC57D\uACF5\uC740\n\uB2E4
      \uB9C9\uD600. \uC2DC\uAC04 \uB0AD\uBE44\uC57C."
    duration: 0
  - key: tut.inf.enforcer.intro.1
    speaker: EGO
    text: "{heavy} \uAC15\uACF5\uC73C\uB85C \uBC29\uD328\uB97C \uAE68\uAC70\uB098\n\uC606\uC73C\uB85C
      \uB3CC\uC544. \uB4A4 \uD130\uB81B \uC870\uC900\uC120\uB3C4 \uC870\uC2EC."
    duration: 0
  - key: tut.inf.enforcer.remind.0
    speaker: EGO
    text: "\uC815\uBA74 \uC57D\uACF5\uC740 \uD295\uACA8.\n\uAC15\uACF5\uC73C\uB85C
      \uAE68, \uCD94\uC628."
    duration: 0
  - key: tut.inf.enforcer.success.0
    speaker: EGO
    text: "\uBC29\uD328 \uBD95\uAD34! \uC9C0\uAE08 \uB05D\uB0B4\uC790."
    duration: 0
  - key: tut.inf.ultimate.intro.0
    speaker: EGO
    text: "\uC2DC\uBBAC\uB808\uC774\uC158\uC774 \uD398\uC774\uC988 \uAC8C\uC774\uC9C0\uB97C\n\uCC44\uC6CC
      \uB480\uC5B4. {ult}\uB85C \uAD81\uADF9\uAE30."
    duration: 0
  - key: tut.inf.ultimate.success.0
    speaker: EGO
    text: "\uBD24\uC9C0? \uC6B0\uB9AC \uB458\uC774 \uC81C\uB300\uB85C\n\uB9DE\uBB3C\uB9AC\uBA74
      \uC774 \uC815\uB3C4\uC57C."
    duration: 0
  - key: tut.inf.exit.intro.0
    speaker: EGO
    text: "\uD6C8\uB828 \uC885\uB8CC. \uB85C\uBE44 \uBB38 \uD328\uB110\uC5D0\uC11C
      {interact}.\n\uC774\uC81C \uD604\uC2E4\uB85C \uB3CC\uC544\uAC04\uB2E4."
    duration: 0
  - key: tut.inf.exit.success.0
    speaker: "\uCD94\uC628"
    text: "\uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4. \uC9C4\uC9DC\uB85C \uAC04\uB2E4."
    duration: 0
  - key: tut.inf.resync.0
    speaker: EGO
    text: "\uB3D9\uAE30\uD654 \uB04A\uACBC\uC5B4. \uCCB4\uD06C\uD3EC\uC778\uD2B8\uB85C\n\uB418\uAC10\uC744\uAC8C.
      \uB2E4\uC2DC \uAC00 \uBCF4\uC790, \uCD94\uC628."
    duration: 0
  - key: tut.inf.respawn.0
    speaker: EGO
    text: "\uB808\uC2A8 \uB2E4\uC2DC. \uC2DC\uBBAC\uB808\uC774\uC158\uC774\n\uD558\uB098
      \uB354 \uB744\uC6CC \uC904\uAC8C."
    duration: 0
