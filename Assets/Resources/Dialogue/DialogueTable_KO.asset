      duration: 0
    - key: 
      speaker: EGO
      text: "\uBE0C\uB808\uC774\uD06C! \uB2E4 \uC3DF\uC544\uBD80\uC5B4!"
      duration: 0
    - key: 
      speaker: "\uCD94\uC628"
      text: "\uD2C8\uC774\uB2E4."
