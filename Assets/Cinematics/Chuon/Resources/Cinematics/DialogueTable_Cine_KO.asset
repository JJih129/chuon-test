--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed665b71816240adbace187e87522dc6, type: 3}
  m_Name: DialogueTable_Cine_KO
  m_EditorClassIdentifier: 
  entries:
  - key: cine.card.night
    speaker: 
    text: "\uADF8\uB0A0 \uBC24"
    duration: 0
  - key: cine.card.dawn
    speaker: 
    text: "\uC0C8\uBCBD"
    duration: 0
  - key: cine.open.0
    speaker: System
    text: "\uAC70\uC810 \uC81C\uC555 \uC644\uB8CC. \uC0DD\uC874\uC790 \uC5C6\uC74C.\n\uD68C\uC218
      \uB300\uC0C1\u2026 \uD655\uC778 \uBD88\uAC00."
    duration: 0
  - key: cine.open.1
    speaker: EGO
    text: "\uCD94\uC628. \u2026\uCD94\uC628, \uB208 \uB5A0."
    duration: 0
  - key: cine.open.2
    speaker: "\uCD94\uC628"
    text: "\u2026\uB2E4\uB4E4."
    duration: 0
  - key: cine.open.3
    speaker: EGO
    text: "\uC815\uBCF4\uAC00 \uC0DC\uC5B4.\n\uC740\uC2E0\uCC98\uB3C4, \uB0B4\uC77C
      \uACBD\uB85C\uB3C4 \uC804\uBD80."
    duration: 0
  - key: cine.open.4
    speaker: EGO
    text: "\uACBD\uB85C\uB294 \uC774\uBBF8 \uD138\uB838\uC5B4.\n\uACC4\uD68D\uB300\uB85C\uBA74
      \uD568\uC815 \uD55C\uAC00\uC6B4\uB370\uC57C."
    duration: 0
  - key: cine.open.5
    speaker: "\uCD94\uC628"
    text: "\uC0C1\uAD00\uC5C6\uC5B4. \uC815\uBA74\uC73C\uB85C \uAC04\uB2E4."
    duration: 0
  - key: cine.open.6
    speaker: EGO
    text: "\uADF8 \uB9D0 \uAE30\uB2E4\uB838\uC5B4. \uAC00\uC790, \uCD94\uC628."
    duration: 0
  - key: cine.sky.0
    speaker: EGO
    text: "\uC720\uB9AC \uC544\uB798\uAC00 \uACA9\uB0A9\uACE0\uC57C.\n\uBD89\uC740
      \uACA9\uB9AC\uC7A5 \uC548\uC5D0\u2026 \uC2E4\uD5D8\uCCB4 \uD558\uB098."
    duration: 0
  - key: cine.sky.1
    speaker: "\uCD94\uC628"
    text: "\u2026\uB098\uB791 \uAC19\uC740 \uB370\uC11C \uB098\uC654\uC5B4."
    duration: 0
  - key: cine.elev.0
    speaker: EGO
    text: "\uBC84\uD2BC \uD558\uB098\uC9DC\uB9AC \uC5D8\uB9AC\uBCA0\uC774\uD130\uB77C.\n\uD3B8\uB3C4
      \uD2F0\uCF13\uC774\uB124."
    duration: 0
  - key: cine.elev.1
    speaker: "\uCD94\uC628"
    text: "\u2026\uB3CC\uC544\uAC08 \uC0DD\uAC01 \uC5C6\uC5B4."
    duration: 0
  - key: cine.elev.2
    speaker: EGO
    text: "\uC54C\uC544. \uADF8\uB7EC\uB2C8\uAE4C \uB05D\uAE4C\uC9C0\n\uAC19\uC774
      \uAC00\uB294 \uAC70\uC57C, \uCD94\uC628."
    duration: 0
  - key: cine.end.0
    speaker: EGO
    text: "\uC7A0\uAE50. \uB204\uAC00 \uD68C\uC120\uC5D0\n\uB07C\uC5B4\uB4E4\uC5C8\uC5B4."
    duration: 0
  barkGroups: []
